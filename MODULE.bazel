# RustEE's Bazel build (docs/design/bazel.md). Versions are the table in build/module/MODULE.bazel (forge build/CONTRACTS.md C4).
module(
    name = "euhedral_rustee",
    version = "0.0.0",
)

# Bazel ignores this override when RustEE is not the root module: a consumer supplies euhedral_build itself. It stays a path
# because container CI has no registry (C8).
# The euhedral_build module (the version table and the shared platforms) is a copy of forge's build/module, loaded through a
# local path until the private registry (C5) publishes it; build/ is in .bazelignore, so its files are not packages of this
# module. It matches forge's except one comment in platforms/BUILD.bazel (it names a program that uses the build). Keep it so; forge's check-repo.sh checks the bazel_dep versions below against the table.
bazel_dep(name = "euhedral_build", version = "0.1.0")
local_path_override(
    module_name = "euhedral_build",
    path = "build/module",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_rust", version = "0.75.0")

# The toolchain is rust-toolchain.toml's version (and mise.toml's). rules_rust takes only a literal, so the version is written
# twice: tools/bazel-gen/tests/toolchain_pin.rs fails when either differs from the toolchain file. host_tools is the cargo that
# crate_universe splices with; rules_rust declares its own at its own version, which moves when rules_rust is bumped, so this
# one has another name and from_cargo is pointed at it.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(
    name = "rust_host_tools_pinned",
    version = "1.99.1",
)
use_repo(rust_host_tools, "rust_host_tools_pinned")

register_toolchains("@rust_toolchains//:all")

# crate_universe reads the workspace's Cargo.toml and Cargo.lock; Cargo owns Cargo.lock (cargo update); the repin below can rewrite it, and CI fails if it does.
# cargo-bazel-lock.json is crate_universe's own lock, derived from them. A local Bazel build does not notice a stale one (with
# `lockfile` set, rules_rust treats the extension as reproducible and keeps it out of MODULE.bazel.lock); the CI step "The crate
# lock is current" and the stale test of tools/bazel-gen (packages and versions only) do. After `cargo update` or any
# Cargo.toml edit, one command refreshes it, MODULE.bazel.lock and Cargo.lock:
#   CARGO_BAZEL_REPIN=1 bazel mod deps --lockfile_mode=update
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    # Required for a consumer: Bazel refuses a non-root module's crate_universe repository without one.
    lockfile = "//:cargo-bazel-lock.json",
    host_tools = "@rust_host_tools_pinned",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "crates")
