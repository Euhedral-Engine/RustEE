# Project flags only (forge build/CONTRACTS.md C3); cache paths are the machine layer's.
common --enable_platform_specific_config

# MODULE.bazel.lock is checked, not re-resolved: a change to MODULE.bazel fails every Bazel command until
# `CARGO_BAZEL_REPIN=1 bazel mod deps --lockfile_mode=update` is run and the lock committed. This does not cover the crates:
# a change to a member's Cargo.toml or to Cargo.lock builds without a word; the CI step "The crate lock is current" catches a stale
# cargo-bazel-lock.json, and the shared generator's stale test a stale package set.
common --lockfile_mode=error

# Windows has no symlinks without developer mode; tests and tools find their data through runfiles directories.
common:windows --enable_runfiles

# Windows path budget: MSVC's link.exe opens no path of 260 characters or more, and a doc test links the toolchain's rlibs
# from inside its runfiles tree (docs/design/bazel.md, "Windows path budget"). These three lines cut the longest path to
# 256 once the output base is short (a machine path, so not set in this file).
# The platform's directory under bazel-out is named by the platform, so the cpu name there is `w` rather than `x64_windows`.
# A Windows host would otherwise target the host platform, whose directory is not renamed (`x64_windows-dbg`, about 266
# characters); CI passes the same platform explicitly.
common:windows --platforms=@euhedral_build//platforms:windows_x86_64
common:windows --experimental_platform_in_output_dir
common:windows --experimental_override_platform_cpu_name=@euhedral_build//platforms:windows_x86_64=w
# `dbg` builds the same code as fastbuild (same opt-level) with debug info, and its directory name is 6 characters shorter.
common:windows --compilation_mode=dbg

# C7
test --test_tag_filters=-gpu,-exclusive
test --test_output=errors
test:gpu --test_tag_filters=gpu
test:gpu --test_env=CUDA_VISIBLE_DEVICES
test:gpu --test_env=EUHEDRAL_NVRTC
test:gpu --test_env=CUDA_HOME
test:gpu --test_env=CUDA_PATH
test:gpu --test_env=LD_LIBRARY_PATH
test:gpu --test_env=EUHEDRAL_DEVICE_REQUIRED=1
test:gpu --test_arg=--nocapture
test:system --test_tag_filters=exclusive
test:system --cache_test_results=no

# C8
build:ci --keep_going
# The CI lease's threads (the `bazel` job's ARBITER_ARGS; test_workflow_twins.py checks they match): Bazel would size
# its actions from every core of the host.
build:ci --local_resources=cpu=8
test:ci --keep_going
test:ci --test_output=errors
common:ci --color=no

try-import %workspace%/user.bazelrc
