# Project flags only (forge build/CONTRACTS.md C3); cache paths are the machine layer's.
common --enable_platform_specific_config

# The lock of the module is checked, not re-resolved: a change to MODULE.bazel or to any Cargo.toml or Cargo.lock fails every
# Bazel command until `bazel mod deps --lockfile_mode=update` is run and MODULE.bazel.lock committed.
common --lockfile_mode=error

# Windows has no symlinks without developer mode; tests and tools find their data through runfiles directories.
common:windows --enable_runfiles

# C7
test --test_tag_filters=-gpu,-exclusive
test --test_output=errors
test:gpu --test_tag_filters=gpu
test:gpu --test_env=CUDA_VISIBLE_DEVICES
test:gpu --test_env=EUHEDRAL_NVRTC
test:gpu --test_env=CUDA_HOME
test:gpu --test_env=CUDA_PATH
test:gpu --test_env=LD_LIBRARY_PATH
test:gpu --test_env=EUHEDRAL_DEVICE_REQUIRED=1
test:gpu --test_arg=--nocapture
test:system --test_tag_filters=exclusive
test:system --cache_test_results=no

# C8
build:ci --keep_going
# The CI lease's threads (the `bazel` job's ARBITER_ARGS; test_workflow_twins.py checks they match): Bazel would size
# its actions from every core of the host.
build:ci --local_resources=cpu=8
test:ci --keep_going
test:ci --test_output=errors
common:ci --color=no

try-import %workspace%/user.bazelrc
