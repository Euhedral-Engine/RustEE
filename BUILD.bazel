load("@euhedral_build//bazel-gen:defs.bzl", "bazel_gen", "bazel_gen_stale_test")

# The root files crate_universe reads, and the root files a test or binary names in its `data`.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "docs/superpowers/specs/2026-10-28-lock-free-hot-path-audit.md",
    "mise.toml",
    "rust-toolchain.toml",
])

# `bazel run //:gazelle` writes the BUILD files from the Cargo manifests (`-- -mode=diff` only checks).
bazel_gen(
    name = "gazelle",
)

# Fails when a BUILD file, or the crate lock, is out of date with the Cargo manifests and Cargo.lock.
bazel_gen_stale_test(
    name = "bazel_gen_stale_test",
    config = "bazel_gen.toml",
    lock = "cargo-bazel-lock.json",
)

# Every member's manifest, BUILD file and target files, for the tests that read the workspace's sources.
