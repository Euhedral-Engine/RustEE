# Bazel and CI's crate lock check read these byte for byte on every platform: LF everywhere.
*.bazel text eol=lf
*.bzl text eol=lf
*.bazelrc text eol=lf
.bazelrc text eol=lf
.bazelversion text eol=lf
.bazelignore text eol=lf
MODULE.bazel.lock text eol=lf
cargo-bazel-lock.json text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf
